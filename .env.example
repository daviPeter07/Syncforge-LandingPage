NEXT_PUBLIC_SITE_URL=https://seu-dominio.com
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-usuario-smtp
SMTP_PASS=sua-senha-smtp
SMTP_FROM_EMAIL=no-reply@seudominio.com

# Turso (SQLite serverless - default: file:data/blog.db local)
# Para desenvolvimento local, não precisa configurar
# TURSO_DATABASE_URL=libsql://seu-db.turso.io
# TURSO_AUTH_TOKEN=seu-token

# Blog Admin (token para criar/editar/deletar posts)
BLOG_API_TOKEN=coloque-um-token-aqui

# Vercel Blob (upload de imagens do blog)
BLOB_READ_WRITE_TOKEN=coloque-o-token-do-vercel-blob-aqui
